ARG PYTHON_IMAGE=docker.io/library/python:3.13-slim
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml requirements.object-platform.lock LICENSE readme.md /app/
COPY src /app/src

RUN pip install --no-cache-dir -c /app/requirements.object-platform.lock /app

CMD ["python", "-m", "object_platform_catalog_api"]
