# The deployment script generates .env.object-platform with random credentials.
# Use a source tree containing only SatDump data, not the repository itself.
OBJECT_PLATFORM_SOURCE_DIR=/mnt/ssd/satellite_raw
OBJECT_PLATFORM_DATA_DIR=/mnt/ssd/goes-platform
OBJECT_PLATFORM_DASHBOARD_BIND=127.0.0.1
OBJECT_PLATFORM_RETENTION_ENABLED=false
OBJECT_PLATFORM_SCAN_INTERVAL_SECONDS=60
OBJECT_PLATFORM_RETENTION_INTERVAL_SECONDS=3600
OBJECT_PLATFORM_RETENTION_GRACE_SECONDS=86400
OBJECT_PLATFORM_METADATA_RETENTION_DAYS=7
GOES_DASHBOARD_WINDOW_HOURS=168
# Optional image overrides; first deployment resolves these to immutable digests.
RUSTFS_IMAGE=docker.io/rustfs/rustfs:1.0.5
COUCHDB_IMAGE=docker.io/library/couchdb:3.5.0
RABBITMQ_IMAGE=docker.io/library/rabbitmq:4.2.0-management
PYTHON_IMAGE=docker.io/library/python:3.14-slim
