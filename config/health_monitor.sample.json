{
  "health": {
    "enabled": true,
    "interval_seconds": 60,
    "state_file": "state/health.json",
    "satdump_unit": "satdump.service",
    "journal": {
      "lookback_seconds": 900,
      "max_gap_seconds": 900,
      "recent_limit": 50,
      "error_keywords": [
        "error",
        "cannot",
        "failed",
        "fatal"
      ],
      "warning_keywords": [
        "warning",
        "retry",
        "degraded"
      ]
    },
    "storage_mounts": [
      "/var/satellite"
    ],
    "satdump_api": {
      "base_url": "http://localhost:8000",
      "status_endpoint": "/api",
      "timeout_seconds": 5.0,
      "thresholds": {
        "min_snr_warning": 2.0,
        "min_snr_error": 1.0,
        "min_peak_snr_warning": 3.0,
        "min_peak_snr_error": 2.0,
        "max_viterbi_ber_warning": 0.12,
        "max_viterbi_ber_error": 0.2,
        "require_deframer_lock": true,
        "require_viterbi_lock": true
      }
    },
    "alert": {
      "webhook_url": "https://discord.com/api/webhooks/REPLACE/ME",
      "username": "GOES Health",
      "min_severity": "error",
      "cooldown_seconds": 900
    }
  }
}
