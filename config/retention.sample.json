{
  "retention": {
    "enabled": true,
    "interval_seconds": 3600,
    "rules": [
      {
        "name": "GOES imagery (Full + Mesos)",
        "directories": [
          "IMAGES/GOES-19",
          "IMAGES/GOES-18",
          "IMAGES/GOES-16"
        ],
        "include": [
          "**/*.png",
          "**/*.jpg",
          "**/*.gif"
        ],
        "exclude": [
          "**/_thumbnails/**",
          "**/*ABI_False_Color*.png",
          "**/*ABI_False_Color*.jpg",
          "**/*ABI_False_Color*.gif",
          "**/*ABI_False_Color*.cbor"
        ],
        "actions": [
          {
            "after": "3d",
            "type": "move",
            "target": "ARCHIVE/WARM/IMAGES"
          },
          {
            "after": "10d",
            "type": "move",
            "target": "ARCHIVE/SEASONAL/IMAGES"
          },
          {
            "after": "21d",
            "type": "delete"
          }
        ]
      },
      {
        "name": "GOES imagery metadata",
        "directories": [
          "IMAGES/GOES-19",
          "IMAGES/GOES-18",
          "IMAGES/GOES-16"
        ],
        "include": [
          "**/product.cbor"
        ],
        "actions": [
          {
            "after": "3d",
            "type": "move",
            "target": "ARCHIVE/WARM/IMAGES"
          },
          {
            "after": "10d",
            "type": "compress",
            "target": "ARCHIVE/SEASONAL/IMAGES",
            "compression": "zstd",
            "keep_original": false
          },
          {
            "after": "400d",
            "type": "delete"
          }
        ]
      },
      {
        "name": "GOES false-color archive",
        "directories": [
          "IMAGES/GOES-19",
          "IMAGES/GOES-18",
          "IMAGES/GOES-16"
        ],
        "include": [
          "**/*ABI_False_Color*.png",
          "**/*ABI_False_Color*.jpg",
          "**/*ABI_False_Color*.gif",
          "**/*ABI_False_Color*.cbor"
        ],
        "actions": [
          {
            "after": "1d",
            "type": "move",
            "target": "ARCHIVE/WARM/IMAGES/false_color"
          },
          {
            "after": "7d",
            "type": "move",
            "target": "ARCHIVE/SEASONAL/IMAGES/false_color"
          },
          {
            "after": "400d",
            "type": "delete"
          }
        ]
      },
      {
        "name": "GOES Level-2 grids",
        "directories": [
          "L2"
        ],
        "include": [
          "**/*.png",
          "**/*.tif",
          "**/*.nc",
          "**/*.cbor"
        ],
        "actions": [
          {
            "after": "7d",
            "type": "move",
            "target": "ARCHIVE/WARM/L2"
          },
          {
            "after": "30d",
            "type": "compress",
            "target": "ARCHIVE/SEASONAL/L2",
            "compression": "zstd",
            "keep_original": false
          },
          {
            "after": "90d",
            "type": "delete"
          }
        ]
      },
      {
        "name": "EMWIN graphics",
        "directories": [
          "EMWIN"
        ],
        "include": [
          "**/*.gif",
          "**/*.jpg",
          "**/*.png",
          "*.gif",
          "*.jpg",
          "*.png"
        ],
        "exclude": [
          "**/text/**"
        ],
        "actions": [
          {
            "after": "7d",
            "type": "move",
            "target": "ARCHIVE/WARM/EMWIN/graphics"
          },
          {
            "after": "21d",
            "type": "move",
            "target": "ARCHIVE/SEASONAL/EMWIN/graphics"
          },
          {
            "after": "90d",
            "type": "delete"
          }
        ]
      },
      {
        "name": "EMWIN bulletins",
        "directories": [
          "EMWIN"
        ],
        "include": [
          "**/*.txt",
          "**/*.TXT",
          "*.txt",
          "*.TXT"
        ],
        "actions": [
          {
            "after": "7d",
            "type": "compress",
            "target": "ARCHIVE/WARM/EMWIN/text",
            "compression": "zstd",
            "keep_original": false
          },
          {
            "after": "60d",
            "type": "move",
            "target": "ARCHIVE/SEASONAL/EMWIN/text"
          },
          {
            "after": "180d",
            "type": "delete"
          }
        ]
      }
    ]
  }
}
